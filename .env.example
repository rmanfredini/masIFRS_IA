# ============================================================
# MAS-IFRS — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ============================================================

# --- PostgreSQL ---
SERVIDOR_POSTGRESQL=localhost
SERVIDOR_POSTGRESQL_PORTA=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_DATABASE=masifrs

# --- GraphDB ---
# Formato: http://<host>:<porta>/repositories/<nome-do-repositorio>
GRAPHDB_URL=http://localhost:7200/repositories/masifrs
GRAPHDB_USER=admin
GRAPHDB_PASSWORD=root
