PREFIX  cao:  <http://my.campus.org/communicative-acts#>
PREFIX  ieso: <https://www.gecad.isep.ipp.pt/ieso/v1.1.0/>
PREFIX  time: <http://www.w3.org/2006/time#>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT  ?dict
WHERE
  { _:b0  rdf:type              cao:StorageDataInform ;
          cao:storageCapacity   _:b1 .
    _:b1  rdf:type              ieso:Energy ;
          ieso:hasDateTime      ?capacity_measurement_timestamp ;
          ieso:hasMeasurementValue  _:b2 .
    _:b2  rdf:type              ieso:MeasurementValue ;
          ieso:hasUnitOfMeasure  ?capacity_unit ;
          ieso:hasLiteralValue  ?capacity_value .
    _:b0  cao:storageCurrentCharge  _:b3 .
    _:b3  rdf:type              ieso:Energy ;
          ieso:hasDateTime      ?charge_measurement_timestamp ;
          ieso:hasMeasurementValue  _:b4 .
    _:b4  rdf:type              ieso:MeasurementValue ;
          ieso:hasUnitOfMeasure  ?charge_unit ;
          ieso:hasLiteralValue  ?charge_value .
    _:b0  cao:storageEfficiency  _:b5 .
    _:b5  rdf:type              ieso:Measurement ;
          ieso:hasDateTime      ?efficiency_measurement_timestamp ;
          ieso:hasMeasurementValue  _:b6 .
    _:b6  rdf:type              ieso:MeasurementValue ;
          ieso:hasUnitOfMeasure  ?efficiency_unit ;
          ieso:hasLiteralValue  ?efficiency_value .
    _:b0  time:hasBeginning     _:b7 .
    _:b7  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?has_beggining .
    _:b0  time:hasEnd           _:b8 .
    _:b8  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?has_end .
    _:b0  time:hasTime          _:b9 .
    _:b9  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?dt
    BIND(concat("{\"message_type\":\"StorageDataInform\",\"capacity\":{\"value\":\"", str(?capacity_value), "\",\"unit\":\"", str(?capacity_unit), "\",\"reading_timestamp\":\"", str(?capacity_measurement_timestamp), "\"},\"charge\":{\"value\":\"", str(?charge_value), "\",\"unit\":\"", str(?charge_unit), "\",\"reading_timestamp\":\"", str(?charge_measurement_timestamp), "\"},\"efficiency\":{\"value\":\"", str(?efficiency_value), "\",\"unit\":\"", str(?efficiency_unit), "\",\"reading_timestamp\":\"", str(?efficiency_measurement_timestamp), "\"},\"has_beggining\":\"", str(?has_beggining), "\",\"has_end\":\"", str(?has_end), "\",\"timestamp\":\"", str(?dt), "\"}") AS ?dict)
  }