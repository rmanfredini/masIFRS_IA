PREFIX  cao:  <http://my.campus.org/communicative-acts#>
PREFIX  time: <http://www.w3.org/2006/time#>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT  ?dict
WHERE
  { _:b0  rdf:type              cao:ActiveRuleInform ;
          cao:activeRule        ?rule ;
          time:hasTime          _:b1 .
    _:b1  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?dt
    BIND(concat("{\"message_type\":\"ActiveRuleInform\",\"active_rule\":\"", str(?rule), "\",\"timestamp\":\"", str(?dt), "\"}") AS ?dict)
  }