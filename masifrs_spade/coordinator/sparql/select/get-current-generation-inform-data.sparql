PREFIX  cao:  <http://my.campus.org/communicative-acts#>
PREFIX  ieso: <https://www.gecad.isep.ipp.pt/ieso/v1.1.0/>
PREFIX  time: <http://www.w3.org/2006/time#>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT  ?dict
WHERE
  { _:b0  rdf:type              cao:CurrentGenerationInform ;
          cao:currentGeneration  _:b1 .
    _:b1  rdf:type              ieso:Energy ;
          ieso:hasDateTime      ?measurement_dt ;
          ieso:hasMeasurementValue  _:b2 .
    _:b2  rdf:type              ieso:MeasurementValue ;
          ieso:hasUnitOfMeasure  ?current_generation_unit ;
          ieso:hasLiteralValue  ?current_generation_value .
    _:b0  time:hasBeginning     _:b3 .
    _:b3  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?has_beggining .
    _:b0  time:hasEnd           _:b4 .
    _:b4  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?has_end .
    _:b0  time:hasTime          _:b5 .
    _:b5  rdf:type              time:Instant ;
          time:inXSDDateTimeStamp  ?dt
    BIND(concat("{\"message_type\":\"CurrentGenerationInform\",\"current_generation\":{\"value\":\"", str(?current_generation_value), "\",\"unit\":\"", str(?current_generation_unit), "\",\"timestamp\":\"", str(?measurement_dt), "\"},\"has_beggining\":\"", str(?has_beggining), "\",\"has_end\":\"", str(?has_end), "\",\"timestamp\":\"", str(?dt), "\"}") AS ?dict)
  }