PREFIX  cao:  <http://my.campus.org/communicative-acts#>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX  xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX  time: <http://www.w3.org/2006/time#>

CONSTRUCT 
  { 
    _:c0 rdf:type cao:DeviceControlInform .
    _:c0 cao:controlledDevice <[DEVICE_IRI]> .
    _:c0 cao:controlledSuccessfully "<[SUCCESS]>"^^xsd:boolean .
    _:c0 time:hasTime _:c1 .
    _:c1 rdf:type time:Instant .
    _:c1 time:inXSDDateTimeStamp ?dt .
  }
WHERE
  { BIND(now() AS ?dt) }