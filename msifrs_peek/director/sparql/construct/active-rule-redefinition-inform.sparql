PREFIX  cao:  <http://my.campus.org/communicative-acts#>
PREFIX  rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX  ieso: <https://www.gecad.isep.ipp.pt/ieso/v1.1.0/>
PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  time: <http://www.w3.org/2006/time#>

CONSTRUCT 
  { 
    _:c0 rdf:type cao:ActiveRuleRedefinitionInform .
    _:c0 cao:activeRule <[RULE_IRI]> .
    _:c0 cao:newAction _:c1 .
    _:c1 rdf:type ieso:ActuationAction .
    _:c1 ieso:description "<[NEW_ACTION]>"^^rdfs:Literal .
    _:c1 ieso:actuateOnDevice <[DEVICE_IRI]> .
    _:c0 time:hasTime _:c2 .
    _:c2 rdf:type time:Instant .
    _:c2 time:inXSDDateTimeStamp ?dt .
  }
WHERE
  { BIND(now() AS ?dt) }